// ---------------------------------------------------------
// Server Route Handlers
// ---------------------------------------------------------

void handleRoot() {
  server.send(200, "text/html", index_html);
}

void handleLatestSignal() {
  if (lastCode == 0) {
    server.send(200, "text/plain", "Waiting for signal...");
    return;
  }
  String msg = "Code: 0x" + String((uint32_t)(lastCode >> 32), HEX) + String((uint32_t)lastCode, HEX) + " (" + lastProtocolName + ")";
  server.send(200, "text/plain", msg);
}

void handleSaveButton() {
  if (!server.hasArg("device") || !server.hasArg("name")) {
    server.send(400, "text/plain", "Missing device or name");
    return;
  }
  if (lastCode == 0 || lastProtocol == UNKNOWN) {
    server.send(400, "text/plain", "No valid IR signal captured yet!");
    return;
  }

  String device = server.arg("device");
  String name = server.arg("name");
  String prefix = device + "_" + name; 
  
  prefs.begin("ir_data", false);
  prefs.putULong64((prefix + "_c").c_str(), lastCode);
  prefs.putUShort((prefix + "_p").c_str(), (uint16_t)lastProtocol);
  prefs.putUShort((prefix + "_b").c_str(), lastBits);

  String btnList = prefs.getString((device + "_list").c_str(), "");
  if (btnList.indexOf(name + ",") == -1) {
    btnList += name + ",";
    prefs.putString((device + "_list").c_str(), btnList);
  }
  
  prefs.end();
  server.send(200, "text/plain", "Saved " + name + " successfully!");
}

void handleGetButtons() {
  String device = server.hasArg("device") ? server.arg("device") : "tv";
  prefs.begin("ir_data", true);
  String btnList = prefs.getString((device + "_list").c_str(), "");
  prefs.end();

  String html = "";
  if (btnList == "") {
    html = "<p style='grid-column: span 3;'>No buttons saved.</p>";
  } else {
    int start = 0;
    int end = btnList.indexOf(',');
    while (end != -1) {
      String btnName = btnList.substring(start, end);
      html += "<button class='remote-btn' onclick='sendCommand(\"" + btnName + "\")'>" + btnName + "</button>";
      start = end + 1;
      end = btnList.indexOf(',', start);
    }
  }
  server.send(200, "text/html", html);
}

void handleSendCommand() {
  if (!server.hasArg("device") || !server.hasArg("name")) {
    server.send(400, "text/plain", "Error");
    return;
  }
  String prefix = server.arg("device") + "_" + server.arg("name");
  
  prefs.begin("ir_data", true);
  uint64_t codeToSend = prefs.getULong64((prefix + "_c").c_str(), 0);
  decode_type_t protToSend = (decode_type_t)prefs.getUShort((prefix + "_p").c_str(), UNKNOWN);
  uint16_t bitsToSend = prefs.getUShort((prefix + "_b").c_str(), 0);
  prefs.end();

  if (codeToSend != 0) {
    irsend.send(protToSend, codeToSend, bitsToSend);
    irrecv.resume(); 
    server.send(200, "text/plain", "Sent");
  } else {
    server.send(404, "text/plain", "Not Found");
  }
}

// ---------------------------------------------------------
// Setup & Loop
// ---------------------------------------------------------

void setup() {
  Serial.begin(115200);

  irrecv.enableIRIn(); 
  irsend.begin();

  WiFi.softAP(ssid, password);
  Serial.println("\nWiFi AP Started.");
  Serial.print("Connect to network 'SmartRemote_ESP32' with password 'password123'.\n");
  Serial.print("Then open browser to IP: ");
  Serial.println(WiFi.softAPIP());

  server.on("/", handleRoot);
  server.on("/latest_signal", handleLatestSignal);
  server.on("/save_button", HTTP_GET, handleSaveButton);
  server.on("/get_buttons", HTTP_GET, handleGetButtons);
  server.on("/send_command", HTTP_GET, handleSendCommand);

  server.begin();
}

void loop() {
  server.handleClient();

  if (irrecv.decode(&results)) {
    if (results.decode_type != UNKNOWN && !results.repeat) {
      lastCode = results.value;
      lastProtocol = results.decode_type;
      lastBits = results.bits;
      lastProtocolName = typeToString(results.decode_type);
      
      Serial.print("Received: 0x");
      serialPrintUint64(lastCode, HEX);
      Serial.println(" (" + lastProtocolName + ")");
    }
    irrecv.resume(); 
  }
}
