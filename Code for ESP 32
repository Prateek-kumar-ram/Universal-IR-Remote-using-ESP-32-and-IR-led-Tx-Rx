/*
 * HARDWARE CONNECTIONS:
 * ---------------------------------------------------------
 * IR Receiver (3-Pin Module):
 *   - VCC (Right)  -> ESP32 3.3V
 *   - GND (Middle) -> ESP32 GND
 *   - OUT (Left)   -> ESP32 GPIO 15
 *
 * IR Transmitter (Clear LED - Direct Test Mode):
 *   - Anode (Long leg)    -> ESP32 GPIO 4
 *   - Cathode (Short leg) -> Two 220Ω Resistors in parallel -> ESP32 GND
 * ---------------------------------------------------------
 */

#include <Arduino.h>
#include <WiFi.h>
#include <WebServer.h>
#include <Preferences.h>
#include <IRrecv.h>
#include <IRutils.h>
#include <IRsend.h>

// WiFi Access Point Credentials
const char* ssid = "SmartRemote_ESP32";
const char* password = "password123";

WebServer server(80);
Preferences prefs;

// Pin Definitions
const uint16_t kRecvPin = 15;
const uint16_t kIrLedPin = 4;

IRrecv irrecv(kRecvPin);
IRsend irsend(kIrLedPin);
decode_results results;

// Variables to hold the most recently captured signal
uint64_t lastCode = 0;
decode_type_t lastProtocol = UNKNOWN;
uint16_t lastBits = 0;
String lastProtocolName = "None";

